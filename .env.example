# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Variables del stack completo EduAirControl
# USAGE: cp .env.example .env   (y edita los valores locales)
# NUNCA subas el .env real; en producción los secretos van en una bóveda.
# ─────────────────────────────────────────────────────────────────────────────

# General
REGISTRY=eduaircontrol
TAG=local
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend web (:3000)
WEB_PORT=3000
# URL del gateway tal y como la ve el NAVEGADOR (se incrusta en el bundle en build).
# Si accedes desde otra máquina, pon aquí la IP del host.
VITE_API_URL=http://localhost:8080

# API Gateway (:8080)
GATEWAY_PORT=8080
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60
# JWT: issuer/audience que ms-security emite y api-gateway exige. En local el
# emisor interno es http://ms-security:8081; en produccion, la URL publica
# (https://api.eduaircontrol.tech) para que coincida con el token.
AUTH_ISSUER=http://ms-security:8081
AUTH_AUDIENCE=eduaircontrol-api

# Redis (:6379) — rate limiting del gateway + blacklist de tokens
REDIS_PORT=6379

# ms-security (:8081)
SECURITY_DB=eduaircontrol_security
SECURITY_USER=security_user
SECURITY_PASSWORD=security_pass
SECURITY_DB_PORT=5437
# Cuenta que se siembra al arrancar. OBLIGATORIO: genera una contraseña fuerte
# (R-002) — compose y ms-security fallan al arrancar si no esta definida.
SUPERADMIN_EMAIL=admin@eduaircontrol.com
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=

# Correo SMTP — recuperación de contraseña (ms-security). Con SMTP_HOST vacío el
# código se registra en el log en lugar de enviarse (modo desarrollo).
# Producción: Gmail con contraseña de aplicación (https://myaccount.google.com/apppasswords).
# Desarrollo: docker compose --profile dev up -d mailpit y SMTP_HOST=mailpit,
# SMTP_PORT=1025 (UI de captura en http://localhost:8025).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ── Login social (Google / Facebook) — ms-security ────────────────────────────
# 1) Crea credenciales:
#    - Google: https://console.cloud.google.com/apis/credentials (OAuth client ID, tipo Web)
#    - Facebook: https://developers.facebook.com/apps (Facebook Login)
# 2) Registra como "Authorized redirect URI" (debe ser HTTPS publico):
#    <SOCIAL_CALLBACK_BASE_URL>/api/v1/auth/oauth2/google/callback
#    <SOCIAL_CALLBACK_BASE_URL>/api/v1/auth/oauth2/facebook/callback
#    En local no hay URL publica: usa un tunel (p. ej. ngrok) y pon esa base.
# 3) Rellena las credenciales y la base publica del callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Base publica (https) para los callbacks. Vacia = usa OAUTH2_ISSUER.
SOCIAL_CALLBACK_BASE_URL=
# A donde vuelve el navegador tras el login social.
FRONTEND_URL=http://localhost:3000
# Emisor del Authorization Server / base de callback por defecto.
OAUTH2_ISSUER=http://localhost:8081

# ms-classroom-management (:3002)
CLASSROOM_DB=eduaircontrol_classrooms
CLASSROOM_USER=classroom_user
CLASSROOM_PASSWORD=classroom_pass
CLASSROOM_DB_PORT=5433

# ms-environment-monitoring (:3003)
MONITORING_DB=eduaircontrol_monitoring
MONITORING_USER=monitoring_user
MONITORING_PASSWORD=monitoring_pass
MONITORING_DB_PORT=5435
DB_CHANGELOG_CONTEXTS=

# ms-sensor-management (:3004)
SENSOR_DB=eduaircontrol_sensors
SENSOR_USER=sensor_user
SENSOR_PASSWORD=sensor_pass
SENSOR_DB_PORT=5434

# ms-user-experience (:3006)
USER_EXPERIENCE_DB=eduaircontrol_user_experience
USER_EXPERIENCE_USER=user_experience_user
USER_EXPERIENCE_PASSWORD=user_experience_pass
USER_EXPERIENCE_DB_PORT=5439

# ms-user-management (:3007)
USER_MANAGEMENT_DB=eduaircontrol_user_management
USER_MANAGEMENT_USER=user_management_user
USER_MANAGEMENT_PASSWORD=user_management_pass
USER_MANAGEMENT_DB_PORT=5438

# RabbitMQ (:5672, panel :15672)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT_HOST=5672
RABBITMQ_MGMT_PORT=15672

# Accesos RS256 (ADR-006): los servicios NO comparten secreto. Validan los
# tokens de ms-security contra su JWKS, que se resuelve con esta URL interna.
# No hace falta configurarla en docker compose: va inyectada en cada servicio.
# JWT_PUBLIC_KEY_PATH=

# ─────────────────────────────────────────────────────────────────────────────
# CI/CD — Jenkins (ADR-019, overlay docker-compose.jenkins.yml)
# ─────────────────────────────────────────────────────────────────────────────
# Puerto HTTP del panel, SOLO en 127.0.0.1 (se expone vía Caddy en
# jenkins.eduaircontrol.tech o con un túnel SSH a localhost:8085).
JENKINS_PORT=8085
# En el VPS, REGISTRY/TAG se cambian a ghcr.io/eduaircontrol y latest para que
# `docker compose pull` obtenga las imágenes que sube el pipeline de deploy:
#   REGISTRY=ghcr.io/eduaircontrol
#   TAG=latest
# Credencial de GitHub (PAT) que usa el pipeline de deploy para hacer push a
# GHCR: username = usuario del bot, token con scope write:packages.
# En el VPS una sola vez: echo $GHCR_TOKEN | docker login ghcr.io -u $GHCR_USER --password-stdin
GHCR_USER=
GHCR_TOKEN=

# Cookies (web BFF)
COOKIE_SECURE=false
