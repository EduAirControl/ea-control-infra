# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Variables del sistema completo EduAirControl
# USAGE: cp .env.example .env   (y edita valores locales)
# NUNCA subas el .env real; en prod los secretos van en la bóveda.
# ─────────────────────────────────────────────────────────────────────────────

# General
REGISTRY=eduaircontrol
TAG=local
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# API Gateway (:8080)
GATEWAY_PORT=8080
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# Redis (:6379) — rate limiting del gateway + blacklist de tokens
REDIS_PORT=6379

# ms-security (:8081)
SECURITY_DB=eduaircontrol_security
SECURITY_USER=security_user
SECURITY_PASSWORD=security_pass
SECURITY_DB_PORT=5437

# Cliente OAuth2 de los nodos ESP32 (client_credentials).
# El secreto DEBE estar definido o ms-security no registra el cliente y el
# firmware recibe 401 en POST /oauth2/token. Generar con: openssl rand -base64 48
DEVICE_OAUTH2_CLIENT_ID=ea-control-device
DEVICE_OAUTH2_CLIENT_SECRET=
# Duracion del access token en formato ISO-8601 (el nodo lo renueva solo).
DEVICE_OAUTH2_ACCESS_TTL=PT1H

# ms-classroom-management (:3002)
CLASSROOM_DB=eduaircontrol_classrooms
CLASSROOM_USER=classroom_user
CLASSROOM_PASSWORD=classroom_pass
CLASSROOM_DB_PORT=5433

# ms-sensor-management (:3004)
SENSOR_DB=eduaircontrol_sensors
SENSOR_USER=sensor_user
SENSOR_PASSWORD=sensor_pass
SENSOR_DB_PORT=5434

# ms-user-management (:3007)
USER_MANAGEMENT_DB=eduaircontrol_user_management
USER_MANAGEMENT_USER=user_management_user
USER_MANAGEMENT_PASSWORD=user_management_pass
USER_MANAGEMENT_DB_PORT=5438

# ms-environment-monitoring (:3003)
MONITORING_DB=eduaircontrol_monitoring
MONITORING_USER=monitoring_user
MONITORING_PASSWORD=monitoring_pass
MONITORING_DB_PORT=5435

# RabbitMQ (:5672, panel :15672)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT_HOST=5672
RABBITMQ_MGMT_PORT=15672

# JWT interino HS256 de classroom/sensor (el gateway usa RS256/JWKS de ms-security)
JWT_SECRET=change-me-in-vault
