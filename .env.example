# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Variables del stack completo EduAirControl
# USAGE: cp .env.example .env   (y edita los valores locales)
# NUNCA subas el .env real; en producción los secretos van en una bóveda.
# ─────────────────────────────────────────────────────────────────────────────

# General
REGISTRY=eduaircontrol
TAG=local
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend web (:3000)
WEB_PORT=3000
# URL del gateway tal y como la ve el NAVEGADOR (se incrusta en el bundle en build).
# Si accedes desde otra máquina, pon aquí la IP del host.
VITE_API_URL=http://localhost:8080

# API Gateway (:8080)
GATEWAY_PORT=8080
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# Redis (:6379) — rate limiting del gateway + blacklist de tokens
REDIS_PORT=6379

# ms-security (:8081)
SECURITY_DB=eduaircontrol_security
SECURITY_USER=security_user
SECURITY_PASSWORD=security_pass
SECURITY_DB_PORT=5437
# Cuenta que se siembra al arrancar. CAMBIALA antes de cualquier despliegue.
SUPERADMIN_EMAIL=admin@eduaircontrol.com
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=EduAirControl1!

# ms-classroom-management (:3002)
CLASSROOM_DB=eduaircontrol_classrooms
CLASSROOM_USER=classroom_user
CLASSROOM_PASSWORD=classroom_pass
CLASSROOM_DB_PORT=5433

# ms-environment-monitoring (:3003)
MONITORING_DB=eduaircontrol_monitoring
MONITORING_USER=monitoring_user
MONITORING_PASSWORD=monitoring_pass
MONITORING_DB_PORT=5435
DB_CHANGELOG_CONTEXTS=

# ms-sensor-management (:3004)
SENSOR_DB=eduaircontrol_sensors
SENSOR_USER=sensor_user
SENSOR_PASSWORD=sensor_pass
SENSOR_DB_PORT=5434

# ms-user-experience (:3006)
USER_EXPERIENCE_DB=eduaircontrol_user_experience
USER_EXPERIENCE_USER=user_experience_user
USER_EXPERIENCE_PASSWORD=user_experience_pass
USER_EXPERIENCE_DB_PORT=5439

# ms-user-management (:3007)
USER_MANAGEMENT_DB=eduaircontrol_user_management
USER_MANAGEMENT_USER=user_management_user
USER_MANAGEMENT_PASSWORD=user_management_pass
USER_MANAGEMENT_DB_PORT=5438

# RabbitMQ (:5672, panel :15672)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT_HOST=5672
RABBITMQ_MGMT_PORT=15672

# Accesos RS256 (ADR-006): los servicios NO comparten secreto. Validan los
# tokens de ms-security contra su JWKS, que se resuelve con esta URL interna.
# No hace falta configurarla en docker compose: va inyectada en cada servicio.
# JWT_PUBLIC_KEY_PATH=
