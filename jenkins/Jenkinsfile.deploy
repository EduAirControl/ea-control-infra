// Deploy automatico de un servicio (ADR-019). Encadenado por test-<servicio>
// cuando el push es sobre main: build de la imagen -> push a GHCR ->
// `docker compose pull/up` del stack del VPS -> wait + smoke.
//
// Repositorio ya testeado; aqui solo importa el artefacto (imagen inmutable
// etiquetada con el SHA + latest).
//
// Nota: el checkout usa el FQN de GitSCM y la URL en userRemoteConfigs
// (en este core el lookup por nombre corto "Git" resuelve null).
//
// El stack (/opt/eduaircontrol) esta montado RO en el contenedor Jenkins:
// los sh hacen `cd` ahi (lectura de .env, compose files y scripts de smoke)
// sin depender del paso `dir()` de Jenkins, que exige escritura en el cwd.
pipeline {
  agent any
  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }
  environment {
    STACK_DIR = '/opt/eduaircontrol/infra'
  }
  stages {
    stage('Checkout') {
      steps {
        checkout([$class: 'hudson.plugins.git.GitSCM',
                  userRemoteConfigs: [[url: "${REPO_URL}", credentialsId: 'github-infra']],
                  branches: [[name: "${COMMIT_SHA}"]],
                  extensions: [[$class: 'hudson.plugins.git.extensions.impl.CloneOption',
                                shallow: false, depth: 1, noTags: true]]])
      }
    }
    stage('Build image') {
      steps {
        sh '''
          set -eu
          cd "${STACK_DIR}"
          set -a; . ./.env; set +a   # REGISTRY, TAG, VITE_API_URL
          IMAGE="ea-control-${SERVICE_NAME}"
          if [ "${SERVICE_NAME}" = "web" ]; then
            CTX="${WORKSPACE}/apps/web"
            docker build --build-arg "VITE_API_URL=${VITE_API_URL}" \\
              -t "${REGISTRY}/${IMAGE}:${COMMIT_SHA}" -t "${REGISTRY}/${IMAGE}:latest" \\
              "${CTX}"
          else
            docker build \\
              -t "${REGISTRY}/${IMAGE}:${COMMIT_SHA}" -t "${REGISTRY}/${IMAGE}:latest" \\
              "${WORKSPACE}"
          fi
        '''
      }
    }
    stage('Push GHCR') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'ghcr-bot',
                                          usernameVariable: 'GH_USER',
                                          passwordVariable: 'GH_TOKEN')]) {
          sh '''
            set -eu
            cd "${STACK_DIR}"
            set -a; . ./.env; set +a
            IMAGE="ea-control-${SERVICE_NAME}"
            echo "${GH_TOKEN}" | docker login ghcr.io -u "${GH_USER}" --password-stdin
            docker push "${REGISTRY}/${IMAGE}:${COMMIT_SHA}"
            docker push "${REGISTRY}/${IMAGE}:latest"
          '''
        }
      }
    }
    stage('Deploy (compose pull + up)') {
      steps {
        sh '''
          set -eu
          cd "${STACK_DIR}"
          set -a; . ./.env; set +a
          COMPOSE="docker compose -f docker-compose.yml -f docker-compose.cloud.yml -f docker-compose.observability.yml"
          $COMPOSE pull "${SERVICE_NAME}"
          $COMPOSE up -d --no-build "${SERVICE_NAME}"
        '''
      }
    }
    // Smoke en red host (los puertos del stack publican en 127.0.0.1 del VPS,
    // inalcanzables desde la red del contenedor de Jenkins).
    stage('Smoke') {
      steps {
        sh '''
          set -eu
          cd "${STACK_DIR}"
          set -a; . ./.env; set +a
          docker run --rm --network host \\
            --entrypoint bash \\
            --env-file .env \\
            -v "${STACK_DIR}/scripts:/scripts:ro" \\
            "${REGISTRY}/jenkins:local" \\
            -c 'cd /scripts && ./wait-for-services.sh && ./smoke.sh'
        '''
      }
    }
  }
  post {
    // Notificacion a Discord inline (sin libreria cargada: el load en un
    // stage no deja la referencia disponible en post bajo CPS declarativo).
    always {
      script {
        try {
          def status = currentBuild.currentResult ?: 'UNKNOWN'
          def color  = [SUCCESS: 3066993, FAILURE: 15158332, UNSTABLE: 16776960, ABORTED: 9807270].get(status, 9807270)
          def emoji  = [SUCCESS: '✅', FAILURE: '❌', UNSTABLE: '⚠️', ABORTED: '⏹'].get(status, '❓')
          def fields = [
            [name: 'Servicio', value: (env.SERVICE_NAME ?: '—').toString().take(1024), inline: true],
            [name: 'Commit',   value: (env.COMMIT_SHA ?: '—').take(7), inline: true],
            [name: 'Imagen',   value: "ea-control-${env.SERVICE_NAME}:${env.COMMIT_SHA}", inline: true],
            [name: 'Duracion', value: currentBuild.durationString, inline: true]
          ]
          def payload = groovy.json.JsonOutput.toJson([
            username: 'Jenkins CI',
            embeds: [[
              title:     "${emoji} ${env.JOB_NAME} #${env.BUILD_NUMBER} — ${status}",
              url:       env.BUILD_URL,
              color:     color,
              fields:    fields,
              footer:    [text: env.BUILD_URL ?: ''],
              timestamp: new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC'))
            ]]
          ])
          withCredentials([string(credentialsId: 'discord-webhook', variable: 'DISCORD_WEBHOOK')]) {
            writeFile file: 'discord-notify.json', text: payload
            sh 'curl -sS -m 20 -X POST -H "Content-Type: application/json" ' +
               '-d @discord-notify.json "$DISCORD_WEBHOOK" > /dev/null || true'
          }
        } catch (e) {
          echo "No se pudo notificar a Discord: ${e.message}"
        }
      }
    }
    failure {
      echo "Deploy fallido: ${env.SERVICE_NAME} @ ${env.COMMIT_SHA}. " +
           "Rollback: TAG=<sha-sano> y docker compose up -d --no-build ${env.SERVICE_NAME} " +
           "desde ${env.STACK_DIR} (ver docs-ea-control/10-devops/ci-cd.md)."
    }
  }
}
