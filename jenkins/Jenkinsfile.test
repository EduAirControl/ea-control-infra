```groovy
// Tests de un repositorio (ADR-019). Lo ejecuta el job test-<servicio>
// definido en jobs.groovy; se activa con un webhook de push a develop/main.
//
// Variables que inyecta Generic Webhook Trigger (parámetros del job):
//   REPO_URL     — clone URL del repositorio que ha hecho push
//   COMMIT_SHA   — commit exacto a verificar
//   REF          — refs/heads/<rama>
// SERVICE_NAME se deriva del nombre del job (test-<servicio>).
//
// Nota: el checkout usa el FQN de GitSCM y la URL en userRemoteConfigs
// (en este core el lookup por nombre corto "Git" resuelve null).
pipeline {
  agent any
  options {
    timestamps()
    disableConcurrentBuilds(abortPrevious: true)
    buildDiscarder(logRotator(numToKeepStr: '30'))
  }
  stages {
    stage('Setup') {
      steps {
        script {
          env.SERVICE_NAME = env.JOB_NAME.replaceFirst('^test-', '')
        }
      }
    }
    stage('Checkout') {
      steps {
        checkout([$class: 'hudson.plugins.git.GitSCM',
                  userRemoteConfigs: [[url: "${REPO_URL}", credentialsId: 'github-infra']],
                  branches: [[name: "${COMMIT_SHA}"]],
                  extensions: [[$class: 'hudson.plugins.git.extensions.impl.CloneOption',
                                shallow: false, depth: 1, noTags: true]]])
      }
    }
    stage('Verify') {
      steps {
        script {
          if (env.SERVICE_NAME == 'web') {
            dir('apps/web') {
              sh 'npm ci'
              sh 'npm run build'
            }
          } else {
            sh 'chmod +x ./mvnw'
            sh './mvnw -B -ntp verify'
          }
        }
      }
    }
    // En main, tras tests verdes, se despliega (deploy encadenado).
    stage('Deploy gate (main)') {
      when { environment name: 'REF', value: 'refs/heads/main' }
      steps {
        build job: "deploy-${env.SERVICE_NAME}",
              wait: true,
              parameters: [
                string(name: 'REPO_URL', value: "${env.REPO_URL}"),
                string(name: 'COMMIT_SHA', value: "${env.COMMIT_SHA}"),
                string(name: 'SERVICE_NAME', value: "${env.SERVICE_NAME}")
              ]
      }
    }
  }
  post {
    // Notificacion a Discord inline (sin libreria cargada: el load en un
    // stage no deja la referencia disponible en post bajo CPS declarativo).
    always {
      script {
        try {
          def status = currentBuild.currentResult ?: 'UNKNOWN'
          def color  = [SUCCESS: 3066993, FAILURE: 15158332, UNSTABLE: 16776960, ABORTED: 9807270].get(status, 9807270)
          def emoji  = [SUCCESS: '✅', FAILURE: '❌', UNSTABLE: '⚠️', ABORTED: '⏹'].get(status, '❓')
          def fields = [
            [name: 'Servicio', value: (env.SERVICE_NAME ?: '—').toString().take(1024), inline: true],
            [name: 'Rama',     value: (env.REF ?: '—').replaceFirst('^refs/heads/', '').toString().take(1024), inline: true],
            [name: 'Commit',   value: (env.COMMIT_SHA ?: '—').take(7), inline: true],
            [name: 'Duracion', value: currentBuild.durationString, inline: true]
          ]
          def payload = groovy.json.JsonOutput.toJson([
            username: 'Jenkins CI',
            embeds: [[
              title:     "${emoji} ${env.JOB_NAME} #${env.BUILD_NUMBER} — ${status}",
              url:       env.BUILD_URL,
              color:     color,
              fields:    fields,
              footer:    [text: env.BUILD_URL ?: ''],
              timestamp: new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC'))
            ]]
          ])
          withCredentials([string(credentialsId: 'discord-webhook', variable: 'DISCORD_WEBHOOK')]) {
            writeFile file: 'discord-notify.json', text: payload
            sh 'curl -sS -m 20 -X POST -H "Content-Type: application/json" ' +
               '-d @discord-notify.json "$DISCORD_WEBHOOK" > /dev/null || true'
          }
        } catch (e) {
          echo "No se pudo notificar a Discord: ${e.message}"
        }
      }
    }
    failure { echo "Tests fallidos: ${env.SERVICE_NAME} @ ${env.COMMIT_SHA} (${env.REPO_URL})" }
    fixed   { echo "Tests recuperados: ${env.SERVICE_NAME} @ ${env.COMMIT_SHA}" }
  }
}
```